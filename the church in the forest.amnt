          "ln_mvc5srcm_4jhug": {
            "id": "ln_mvc5srcm_4jhug",
            "type": "line",
            "speaker": "Alex",
            "text": "Non so che farmi di tutti questi oggetti preziosi... Aspetta! in fondo alla cassa ci sono tre chiavi...",
            "next": "n2",
            "ui": {
              "x": -394,
              "y": 128
            }
          },
          "ln_mvc5xt5g_cwifo": {
            "id": "ln_mvc5xt5g_cwifo",
            "type": "line",
            "speaker": "Alex",
            "text": "Scelgo questa chiave con la pietra di rubino, ho sempre adorato il rosso del sangue...",
            "next": "ln_mvc6d05p_ahhg7",
            "ui": {
              "x": 312,
              "y": 74
            }
          },
          "ln_mvc5yejx_yvv51": {
            "id": "ln_mvc5yejx_yvv51",
            "type": "line",
            "speaker": "Alex",
            "text": "Prendo questa chiave d'ossa. Mi fa pensare ad una vecchia reliquia Sacra...",
            "next": "ln_mvc6ihku_goh24",
            "ui": {
              "x": 316,
              "y": 190
            }
          },
          "ln_mvc5ytmu_n3r9l": {
            "id": "ln_mvc5ytmu_n3r9l",
            "type": "line",
            "speaker": "Alex",
            "text": "Adoro il blu, prendo la chiave con l'ala di zaffiro...",
            "next": "ln_mvc6j3lg_h54d2",
            "ui": {
              "x": 313,
              "y": 304
            }
          },
          "ln_mvc5zu8j_w709h": {
            "id": "ln_mvc5zu8j_w709h",
            "type": "line",
            "speaker": "Alex",
            "text": "Voglio pensarci ancora un pò.",
            "next": "n_end",
            "ui": {
              "x": 327,
              "y": 414
            }
          },
          "ln_mvc6d05p_ahhg7": {
            "id": "ln_mvc6d05p_ahhg7",
            "type": "line",
            "speaker": "sposa",
            "text": "Sei sicuro? Guarda che non si torna più indietro",
            "next": "ch_mvcj2523_1r95z",
            "ui": {
              "x": 541,
              "y": 5
            }
          },
          "ln_mvc6ihku_goh24": {
