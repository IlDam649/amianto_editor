    "scripts": {
      "startup": "",
      "room-change": "",
      "object-interaction": "",
      "Object:scene-bwqfgfs": "// Scope: Object\n// Target: scene-bwqfgfs\n\n// Event: onClick\nfunction on_object_click(object_id, x, y){\nif (!has_item(\"rosario_inv\")){\n  await walk_character(\"Alex\",852, 903 );\n  await show_message(\"Un vecchio rosario racchiuso tra le mani di questa statua...\");\n  set_object_visible(\"rosario_obj\", false);\n  add_to_inventory(\"rosario_inv\",1);\n\n  \n} else return}\n",
      "Inventory:Rosario": "// Scope: Inventory\n// Target: Rosario\n\n// Event: onUseWith\nfunction on_use_with(targetType, targetId, x, y){\n  // Handler per script item inventario (Scope Inventory)\n  // targetType: hotspot | object | character | inventory\n  // targetId: id dell'hotspot/oggetto/item (non il name, salvo coincidano)\n  if (targetId === \"hotspot-hy2pfn7\"){\n    await walk_character(\"Alex\", 857, 879);\n    show_dialogue(\"sposa\", \"Grazie... il mio sposo ne terrà conto della tua gentilezza.\");\n    show_dialogue(\"sposa\", \"Adesso puoi rovistare nella cassa ma attenzione...\");\n    show_dialogue(\"sposa\",\"Puoi prendere solo un oggetto da essa, quindi sceglilo bene.\");\n    clear_carried_item(\"rosario_inv\");  \n    remove_from_inventory(\"rosario_inv\",1);\n\n    Game.setVar(\"rosario_consegnato\",true);\n    return true;\n  }\n}\n",
      "Object:scene-p5nm6qd": "// Scope: Object\n// Target: scene-p5nm6qd\n\n// Event: onClick\nfunction on_object_click(object_id, x, y){\n\n  await walk_character(\"Alex\",1051, 683);\n  load_room(\"statua\",144, 870, \"east\");\n}\n",
      "Room:room-1kpf0tr:on_before_room_change": "// Scope: Room\n// Target: room-1kpf0tr\n// Event: Before room load\n\n// Event: Before room load\nfunction on_before_room_change(oldRoomId, newRoomId){\nset_character_visibility(\"Alex\",false);}\n",
      "Room:room-1kpf0tr:on_room_change": "// Scope: Room\n// Target: room-1kpf0tr\n// Event: After room load\n\n// Event: After room load\nfunction on_room_change(oldRoomId, newRoomId){\nplay_music(\"horror-background-tension-3-254908.ogg\");\n}\n",
      "Room:room-3267yj1:on_room_change": "// Scope: Room\n// Target: room-3267yj1\n// Event: After room load\n\n// Event: After room load\nfunction on_room_change(oldRoomId, newRoomId){\n  set_character_visibility(\"Alex\",true);\n\n  await wait(1000);\n  show_animation(\"occhio_stanza1_1784206950197\");\n  await play_animation(\"occhio_stanza1_1784206950197\", 3);\n  hide_animation(\"occhio_stanza1_1784206950197\");\n}\n\n",
      "Room:room-qif1l62:on_room_change": "// Scope: Room\n// Target: room-qif1l62\n// Event: After room load\n\n// Event: After room load\nfunction on_room_change(oldRoomId, newRoomId){\n  if (!Game.getVar(\"intro_sposa\")){\n  show_dialogue(\"Alex\", \"E te chi cazzo sei?\");\n  start_dialogue(\"sposa\");\n    Game.setVar(\"intro_sposa\",true);\n}else return}\n"
    },
