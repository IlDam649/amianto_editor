    "dialogues": [
      {
        "id": "dlg_mv9615oj_hrei3",
        "name": "sposa",
        "startNodeId": "n1",
        "nodes": {
          "n1": {
            "id": "n1",
            "type": "line",
            "speaker": "sposa",
            "text": "Mi chiamo Celeste, tu chi sei?",
            "next": "ch_mv9idt0n_blbod",
            "ui": {
              "x": -46,
              "y": 84
            }
          },
          "ch_mv9idt0n_blbod": {
            "id": "ch_mv9idt0n_blbod",
            "type": "choice",
            "options": [
              {
                "id": "opt_mv9idt0n_az25r",
                "text": "Mi chiamo Alex...",
                "next": "ln_mvb5t7ls_rqm8q"
              },
              {
                "id": "opt_mv9idt0n_trm5m",
                "text": "Non ricordo nulla...",
                "next": "ln_mvb6dawp_0lxzl"
              }
            ],
            "ui": {
              "x": 340,
              "y": 36
            }
          },
          "end_mv9ifrfg_gapef": {
            "id": "end_mv9ifrfg_gapef",
            "type": "end",
            "ui": {
              "x": 3306,
              "y": 198
            }
          },
          "ln_mvb5o0zu_avyyj": {
            "id": "ln_mvb5o0zu_avyyj",
            "type": "line",
            "speaker": "sposa",
            "text": "Alex... no non credo di conoscerti.\nCome sei finito in questo posto?",
            "next": "ch_mvb5r00l_ovwyw",
            "ui": {
              "x": 852,
              "y": -29
            }
          },
          "ch_mvb5r00l_ovwyw": {
            "id": "ch_mvb5r00l_ovwyw",
            "type": "choice",
            "options": [
              {
                "id": "opt_mvb5r00l_i2q8w",
                "text": "L'ultima cosa che ricordo è un bosco...",
                "next": "ln_mvb60ep7_db2oi"
              },
              {
                "id": "opt_mvb5r00l_xzq4g",
                "text": "Non lo so e non credo di volerlo sapere...",
                "next": "ln_mvb63nwo_6nm9z"
              }
            ],
            "ui": {
              "x": 1103,
              "y": -68
            }
          },
          "ln_mvb5t7ls_rqm8q": {
            "id": "ln_mvb5t7ls_rqm8q",
            "type": "line",
            "speaker": "Alex",
            "text": "Mi chiamo Alex, ti dice qualcosa il mio nome?",
            "next": "ln_mvb5o0zu_avyyj",
            "ui": {
              "x": 608,
              "y": -28
            }
          },
          "ln_mvb60ep7_db2oi": {
            "id": "ln_mvb60ep7_db2oi",
            "type": "line",
            "speaker": "Alex",
            "text": "L'ultima cosa che ricordo è un bosco, poi il buio più profondo.\n\nMi sono svegliato poco fa in una stanza di questa strana chiesa",
            "next": "ln_mvb65ls9_werx8",
            "ui": {
              "x": 1373,
              "y": -35
            }
          },
          "ln_mvb63nwo_6nm9z": {
            "id": "ln_mvb63nwo_6nm9z",
            "type": "line",
            "speaker": "Alex",
            "text": "Non lo so e non credo di volerlo sapere...",
            "next": "ln_mvb65ls9_werx8",
            "ui": {
              "x": 1371,
              "y": 138
            }
          },
          "ln_mvb65ls9_werx8": {
            "id": "ln_mvb65ls9_werx8",
            "type": "line",
            "speaker": "sposa",
            "text": "Hai visto qualcosa che ti ha turbato?",
            "next": "ch_mvb69zal_9c8vj",
            "ui": {
              "x": 1710,
              "y": -25
            }
          },
          "ch_mvb69zal_9c8vj": {
            "id": "ch_mvb69zal_9c8vj",
            "type": "choice",
            "options": [
              {
                "id": "opt_mvb69zal_lcl3c",
                "text": "Ho gia visto questo posto...",
                "next": "ln_mvb6i45k_bb1ja"
              },
              {
                "id": "opt_mvb69zal_wqqz9",
                "text": "Flash dal passato",
                "next": "ln_mvb6iaif_7z2v2"
              },
              {
                "id": "opt_mvb6gfd5_wuc2m",
                "text": "No credo di no...",
                "next": "ln_mvb6ihu7_d12aa"
              }
            ],
            "ui": {
              "x": 2019,
              "y": -54
            }
          },
          "ln_mvb6dawp_0lxzl": {
            "id": "ln_mvb6dawp_0lxzl",
            "type": "line",
            "speaker": "Alex",
            "text": "Mi dispiace ma non ricordo nulla...",
            "next": "ln_mvb6mbzc_5o1l9",
            "ui": {
              "x": 1612,
              "y": 254
            }
          },
          "ln_mvb6i45k_bb1ja": {
            "id": "ln_mvb6i45k_bb1ja",
            "type": "line",
            "speaker": "Alex",
            "text": "Ho gia rivisto questo posto.. sembra tutto un enorme deja-vu",
            "next": "ln_mvb6mbzc_5o1l9",
            "ui": {
              "x": 2295,
              "y": -107
            }
          },
          "ln_mvb6iaif_7z2v2": {
            "id": "ln_mvb6iaif_7z2v2",
            "type": "line",
            "speaker": "Alex",
            "text": "No, ho solo un grandissimo mal di testa e questi flash, che non mi so spiegare.",
            "next": "ln_mvb6mbzc_5o1l9",
            "ui": {
              "x": 2299,
              "y": 7
            }
          },
          "ln_mvb6ihu7_d12aa": {
            "id": "ln_mvb6ihu7_d12aa",
            "type": "line",
            "speaker": "Alex",
            "text": "No, non credo",
            "next": "ln_mvb6mbzc_5o1l9",
            "ui": {
              "x": 2278,
              "y": 129
            }
          },
          "ln_mvb6mbzc_5o1l9": {
            "id": "ln_mvb6mbzc_5o1l9",
            "type": "line",
            "speaker": "Alex",
            "text": "Cosa ci fai qui?",
            "next": "ln_mvb6tsbt_vg52h",
            "ui": {
              "x": 2673,
              "y": 185
            }
          },
          "ln_mvb6tsbt_vg52h": {
            "id": "ln_mvb6tsbt_vg52h",
            "type": "line",
            "speaker": "sposa",
            "text": "Aspetto il mio sposo. Dovrebbe essere qui a momenti",
            "next": "end_mv9ifrfg_gapef",
            "ui": {
              "x": 2963,
              "y": 197
            }
          }
        },
        "editor": {
          "panX": 35.44779174172186,
          "panY": 147.72910348344658,
          "zoom": 0.32443902266989677
        }
      },
